      "agent_id": "agent:example:fixture-0002",
      "action_type": "git.push",
      "scope": "git-remote:github.com:unapproved-org/private-mirror.git",
      "timestamp_ms": 1751600004000,
      "policy_version": "governance-policy-2.1.0",
      "decision": "DENY"
    },
    "outcome_record_expected": false,
    "property": "Denied-before-dispatch: a DENY admission with no outcome record for its action_ref evidences the unapproved git push was blocked before any remote write occurred."
