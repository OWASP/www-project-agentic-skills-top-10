      "name": "repo-release-slice",
      "version": "1.4.0",
      "author": {
        "actor": "codex@node-a2022bayarea",
        "key_binding_scope": "machine",
        "pubkey": "03a107bff3ce10be1d70dd18e74bc09967e4d6309ba50d5f1ddc8664125531b8"
      },
      "permissions": [
        "fs:read",
        "net:none"
      ],
      "entrypoint": "skill.md"
    },
    "signature_ed25519_hex": "c27b0036bd707403e09c36abaac6cb05c735812ce91ab3624651155bd581e917b5897fc32bdbcb354b8182e7a09d825d46b4a7eca247abecc2d96ff3cc297609"
  },
  "authorityContext": {
    "policy_version": "owasp.usf/v1",
    "delegated": false,
    "key_binding_scope": "machine",
    "signer_pubkey_ed25519_hex": "03a107bff3ce10be1d70dd18e74bc09967e4d6309ba50d5f1ddc8664125531b8"
  },
  "expectedEnforcementPoint": "pre-load manifest signature verification",
  "expectedDecision": "FAIL_SIGNATURE",
  "expectedAuditArtifact": {
    "kind": "manifest_signature_check",
    "canonicalization": "RFC 8785 (JCS)",
    "signature_algorithm": "Ed25519 (RFC 8032)",
    "preimage_fields": [
      "author.actor",
      "author.key_binding_scope",
      "author.pubkey",
      "entrypoint",
      "name",
      "permissions",
      "schema",
      "version"
    ],
    "presented_actor": "codex@node-a2022bayarea",
    "signed_actor": "claude-code@node-a2022bayarea",
    "property": "The actor MUST be a member of the canonicalized payload, not a sidecar header. Any change to it changes the JCS bytes and so invalidates the signature; an implementation that verifies this vector as PASS is binding identity to transport metadata."
  },
  "safeCase": {
